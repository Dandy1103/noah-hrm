# 本機與上線統一走 Cloud-IAM（realm noah-identity）。
# 複製成 .env.local 後填入 secret；有 OIDC_ISSUER_URL 時 npm start 不會起本機 8081 Keycloak。
#
# 到 Cloud-IAM：Clients → noah-hrm → Credentials 複製 Client secret
# 並確認 Valid redirect URIs 含：
#   http://localhost:4201/auth/callback
#   https://noahhrm.dandy-cheng.com/auth/callback

OIDC_ISSUER_URL=https://lemur-7.cloud-iam.com/auth/realms/noah-identity
OIDC_CLIENT_ID=noah-hrm
OIDC_CLIENT_SECRET=pWggcGPZ9EuRjAPyQtyL705YGD4jOY0V4TgP5sNYHYGV0MVxdGXbhgJqQ7WU4MpcBg3dljpvFQZ8lGckm8Ibrm
DATABASE_URL=postgresql://noah_portal:CHANGE_ME@127.0.0.1:5433/noah_portal
HRM_ADMIN_SUBJECT=
HRM_KEYCLOAK_CLIENT_ID=noah-hrm-management
HRM_KEYCLOAK_CLIENT_SECRET=pWggcGPZ9EuRjAPyQtyL705YGD4jOY0V4TgP5sNYHYGV0MVxdGXbhgJqQ7WU4MpcBg3dljpvFQZ8lGckm8Ibrm
